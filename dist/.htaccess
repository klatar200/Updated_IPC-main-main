# Network Solutions / Apache config for the IPC standalone Vite build.
# Placed in /public so Vite copies it verbatim into /dist at build time.

# FollowSymLinks (or SymLinksIfOwnerMatch) is REQUIRED for mod_rewrite to run.
# Without it Apache 500s the moment a RewriteRule tries to fire — which is why a
# direct load/refresh of a deep SPA path (/products, /company, …) errored while
# the homepage worked. If the host rejects FollowSymLinks, swap the line below
# for:  Options -MultiViews +SymLinksIfOwnerMatch
Options -MultiViews +FollowSymLinks

# A-5.10 — `/` goes through the front controller too, so the homepage gets the
# same server-filled head as every other route. index.html stays second, so a
# host that cannot run PHP here still serves the static shell.
DirectoryIndex index.php index.html
RewriteEngine On
RewriteBase /

# Force HTTPS. admin/.htaccess has carried this rule since the admin shipped;
# this tree had nothing, so a visitor who arrived on http:// stayed there — and
# /contact.php collects a name, an email address, a phone number and a company
# name. That is the lead form posting PII in cleartext. Same rule, same
# conditions as the admin's, and it must come BEFORE the sitemap rewrite and
# the SPA catch-all so the redirect happens on the original URL.
#
# The X-Forwarded-Proto condition is not optional: behind a TLS-terminating
# proxy %{HTTPS} is "off" on every request and the first condition alone
# redirect-loops. (audit-runs/audit1.md A-02)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Defense-in-depth response headers, mirroring admin/.htaccess.
#
# NO Content-Security-Policy here, deliberately. The admin can carry one because
# it is server-rendered HTML with no external JS; this tree is a React bundle
# that sets inline styles at hundreds of call sites and loads product photos
# from placehold.co for five SKUs, so a CSP written without measuring every
# route against it would break the site while looking like hardening. Adding one
# is real work with its own verification pass, not a line in this block.
#
# X-Frame-Options rather than frame-ancestors for the same reason — it needs no
# policy for the rest of the page.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # env=HTTPS so this is never sent over plain HTTP, where it is meaningless
  # and, on a host that later drops TLS, actively harmful.
  # env=HTTPS is set by mod_ssl only when TLS terminates on THIS server. The
  # redirect above exists because it often does not — %{HTTPS} reads "off" on
  # every request behind a TLS-terminating proxy (audit1 A-02) — so the two
  # rules assumed opposite topologies and, in the proxy case, the one header
  # meant to pin browsers to HTTPS was silently never sent. Set it when either
  # signal says the request arrived over TLS.
  # PUB-1 (audit 2026-09-27) — `SetEnvIf HTTPS "^on$"` NEVER matched: SetEnvIf
  # runs in the header-parser phase and mod_ssl sets HTTPS later, in fixups
  # (mod_setenvif.c / ssl_engine_kernel.c; A/B-tested on Apache 2.4.58). So
  # HSTS went out only when a proxy header arrived. It also matched a CLIENT-
  # sent "HTTPS: on" request header (NEW-V3-1). mod_headers evaluates env= at
  # response time, after fixups, so `env=HTTPS` sees mod_ssl's value — the
  # gating that worked before A-6.5. Two lines, one per topology; "set"
  # replaces, so at most one header is sent. Not `expr=`: it needs Apache
  # 2.4.10+, the host's version is unconfirmed, and an unknown directive here
  # is a 500 on every page.
  #
  # ON PURPOSE no includeSubDomains: a year-long pin over subdomains nobody has
  # checked for TLS (mail, webmail, a host panel) can lock a browser out of
  # them. Add it only once every subdomain is known to serve a valid certificate.
  SetEnvIf X-Forwarded-Proto "^https$" IPC_TLS=1
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=IPC_TLS
</IfModule>

# Suppress version disclosure and directory listings, as the admin already does.
ServerSignature Off
Options -Indexes

# The sitemap is generated from the live catalog (see sitemap.php) but keeps its
# conventional address, so robots.txt, Search Console and any existing
# submission never have to learn that it became dynamic. This must come BEFORE
# the SPA catch-all below, and there is deliberately no sitemap.xml FILE in the
# deploy tree — if one existed, the `!-f` condition on the catch-all would serve
# it and this rule would look like it worked while a stale file shipped.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Serve existing files and directories normally (assets, JSON, .well-known, etc.)
# A missing file under /assets/ must NOT fall through to the SPA shell. The
# build emits content-hashed files there, so a request for one that is not on
# disk is always a mistake — a stale URL, or an FTP deploy that has uploaded the
# new index.html but not yet the new bundle. Answering it with index.html means
# a 200 and Content-Type: text/html where the browser expects JavaScript, which
# it then tries to execute: a blank page and a console error, silently, for the
# length of the upload window. This is the same HTML-as-JS chain PLAN-8 A5
# documents for base:'./'. Let it 404 honestly instead.
# (audit-runs/audit5.md, Low tier)
RewriteCond %{REQUEST_URI} !^/assets/
# PUB-11 (audit 2026-09-27) — the same for every folder of FILES. A missing
# data sheet, photo or data file answered 200 text/html (the site shell), so a
# broken Data Sheet link was invisible to link checkers and Search Console,
# and a browser saved the shell as "datasheet.pdf". Only real routes fall
# through; these 404.
RewriteCond %{REQUEST_URI} !^/(pdfs|uploads|images|data)/
RewriteCond %{REQUEST_URI} !^/(favicon\.ico|apple-touch-icon[^/]*\.png|robots\.txt)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Fall through to index.php so react-router can handle the URL on the client.
# The SPA uses real paths (/products, /contact, etc.) so this rule is essential
# for any direct navigation or refresh on a non-root path.
#
# A-5.10 (WHATS_LEFT §1ar) — index.php, not index.html. It serves the same
# built index.html with this route's title, description, canonical and share
# card filled in from data/*.json, plus a plain-HTML body, for the crawlers
# and link unfurlers that never run the bundle. On any error it serves
# index.html unmodified. REQUEST_URI is still the visitor's URL after this
# internal rewrite, which is what index.php reads.
RewriteRule ^ index.php [QSA,L]

# Long-cache the hashed assets Vite emits under /assets — the filename changes
# whenever the content changes, so it is safe to cache those aggressively.
#
# SCOPE MATTERS. This was a bare <FilesMatch> on the file extension with no path
# restriction, so `immutable, max-age=31536000` also covered /images/products/*,
# /uploads/images/* and /logo.svg — every one of which has a STABLE filename and
# is written by the admin. `immutable` means the browser will not even
# revalidate, so a product photo or logo Rick uploads would not reach a
# returning visitor for a year. "Change your own logo and product photos" is a
# headline promise of this handoff. (AUDIT_v3_FINDINGS NB1)
#
# <Directory> is not allowed in .htaccess, so the scope comes from SetEnvIf on
# the request path. If mod_setenvif is absent the variable is never set and
# nothing is long-cached — the safe direction to fail in.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" IPC_IMMUTABLE=1
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=IPC_IMMUTABLE
    # Owner-editable images and the logo: cached, but revalidated within the
    # hour so an FTP'd or admin-uploaded replacement actually lands.
    Header set Cache-Control "public, max-age=3600" env=!IPC_IMMUTABLE
  </FilesMatch>
  # The HTML shell must NOT be cached — it points to the latest hashed bundle.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip / Brotli where available.
#
# AddOutputFilterByType matches the RESPONSE Content-Type, which Apache assigns
# from mime.types — and the current IANA-derived table maps .js to
# `text/javascript`, not `application/javascript`. httpd has shipped that
# mapping since 2.4.53. So on any host with a current mime.types this list
# matched the CSS and the HTML and missed the one file that matters: the bundle
# went out at 376 kB instead of 108 kB gzip, on the critical path of every cold
# load, for a buyer looking up a part on a phone in a plant.
#
# Both spellings are listed because the correct one depends on the host's
# Apache version, which is not knowable from here — and naming a type the
# server never emits costs nothing. application/xml is sitemap.php.
# (audit-runs/audit6.md A-6.4)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Dotfiles. Apache's stock <Files ".ht*"> does not cover .user.ini, which this
# release ships into public_html/ and which would otherwise be web-readable.
# Same rule data/.htaccess already carries, which is proven on this host.
# <FilesMatch> tests the final path component, so /.well-known/acme-challenge/…
# challenge files are unaffected. (AUDIT_v3_FINDINGS NB15)
<FilesMatch "^\.">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# NEW-N3-1 (audit 2026-09-27) — a php.ini in the web folder is inert under
# mod_php (only .user.ini is read, and only by FastCGI/PHP-FPM) AND was served
# to anyone who asked, with a 200. Older advice said to upload one; if anybody
# does, it must at least not be public. Covers every subfolder (admin/php.ini
# too): <FilesMatch> in .htaccess applies below this directory as well.
<FilesMatch "^(?i:php\.ini|php5\.ini)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
