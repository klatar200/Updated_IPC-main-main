node_modules/
dist/
dist-ssr/
.vite/

# Snapshot of the currently-deployed site. Kept locally as a diff baseline,
# never tracked: _localsite/admin/config.local.php contains the LIVE admin
# password hash and was committed once (169c0d7) — see DEPLOY_READINESS_v2 T1.1.
_localsite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*.swo

# Admin secrets & runtime state — must never enter the repo
admin/config.local.php
admin/config.local.php.bak.*
admin/admin-log.jsonl
# Rotated logs. Both writers rename at 16MB and never delete the archive, and
# the rotated names matched no pattern here — so a bulk `git add` could commit a
# 16MB file of customer names, emails and phone numbers to a PUBLIC repo.
admin/admin-log-*.jsonl
admin/inquiries-*.jsonl
admin/.login-throttle.json
admin/.inquiries-seen.json
admin/.inquiry-log-failed.json
admin/inquiries.jsonl
admin/ALLOW-PASSWORD-RESET

# Scratch files that got committed once by accident
_c.cjs
_check.cjs
_to_delete/

# Customer-uploaded product photos (live server state, like pdfs/)
uploads/images/*
!uploads/images/.gitkeep
# A-5.18 — owner-supplied marketing photos belong here rather than in
# images/site/, which ships with the build and is overwritten on every deploy.
uploads/site/*
!uploads/site/.gitkeep

# Local deploy/backup archives — never ship these to the server or the repo
*.zip

# Data backups written by save_products() / save_site_info() / save_content()
data/products-all.backup.*.json
data/site-info.backup.*.json
data/content.backup.*.json
# Verification harness. The CODE is tracked — those suites are the executable
# form of this release's acceptance criteria, and a blanket ignore meant every
# session rebuilt them from nothing. Never deployed; nothing here ships.
#
# The three generated directories stay out, and two of them are not merely
# noise:
#   site/     ~21 MB mirror of dist/ + admin/ + data/, rebuilt by sync.sh. It
#             also holds admin/config.local.php, which carries a WORKING ADMIN
#             CREDENTIAL — and this repo is public.
#   pristine/ a copy of data/*.json. Tracking it would create a second source
#             of truth for live customer state that can drift from the first,
#             which is exactly the public/products-all.json incident.
#   out/      screenshots and measurements, regenerable by re-running a suite.
#
# Bootstrap after a fresh clone: npm run build && sh _harness/sync.sh
_harness/site/
_harness/pristine/
_harness/out/
