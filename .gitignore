node_modules/
dist/
dist-ssr/
.vite/

# Snapshot of the currently-deployed site. Kept locally as a diff baseline,
# never tracked: _localsite/admin/config.local.php contains the LIVE admin
# password hash and was committed once (169c0d7) — see DEPLOY_READINESS_v2 T1.1.
_localsite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Editor swap files
*.swp
*.swo

# Admin secrets & runtime state — must never enter the repo
admin/config.local.php
admin/config.local.php.bak.*
admin/admin-log.jsonl
admin/.login-throttle.json
admin/inquiries.jsonl
admin/ALLOW-PASSWORD-RESET

# Scratch files that got committed once by accident
_c.cjs
_check.cjs
_to_delete/

# Customer-uploaded product photos (live server state, like pdfs/)
uploads/images/*
!uploads/images/.gitkeep

# Local deploy/backup archives — never ship these to the server or the repo
*.zip

# Data backups written by save_products() / save_site_info() / save_content()
data/products-all.backup.*.json
data/site-info.backup.*.json
data/content.backup.*.json
# Session-3 verification harness (local only, never deployed)
_harness/
