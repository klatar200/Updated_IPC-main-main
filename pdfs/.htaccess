# Prevent directory listing
Options -Indexes

# Block script execution — uploaded PDFs must never be executed.
#
# This matched "\.php$" only, which is narrower than it looks and narrower than
# the rule uploads/.htaccess already carries:
#   * mod_mime resolves extensions case-INSENSITIVELY, so x.PHP slipped past;
#   * "$"-anchoring misses the classic double-extension form x.php.pdf, which
#     mod_mime does hand to the PHP handler on a typical AddHandler host;
#   * phtml/phar/pl/py/cgi/sh were not covered at all.
# Nothing can put such a file here today — upload-pdf.php validates extension
# and sniffed MIME and derives its own filename — but this rule is the layer
# that is supposed to hold when something else fails, so it should match the
# stronger rule rather than trail it. (audit-runs/audit5.md, Low tier)
<FilesMatch "\.(?i:php|phtml|phps|php[0-9]|pht|phar|pl|py|cgi|sh|asp|aspx|jsp)(\.|$)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Only allow GET requests (PDFs are read-only assets; GET covers HEAD)
# NOT A TRACE GUARD — do not read it as one. TRACE is answered by Apache core
# before any .htaccess rule runs: LimitExcept, Rewrite [F] and <If> all miss
# it, and `TraceEnable Off` (the only switch) is not allowed in .htaccess.
# Measured (audit 2026-09-27 NEW-N3-6): TRACE → 200, echoing the request
# headers, IPCADMIN cookie included. Browsers cannot send TRACE, so the risk
# is small; the host must turn it off — GO-LIVE §C has the one-line check.
<LimitExcept GET>
    Order Allow,Deny
    Deny from all
</LimitExcept>

# PUB-10 (audit 2026-09-27) — a replaced data sheet keeps its filename, and
# with no Cache-Control at all browsers cached it heuristically (10% of its
# age: weeks, for an old sheet). Revalidate before every use instead; an
# unchanged sheet costs a 304.
<IfModule mod_headers.c>
  <FilesMatch "\.(?i:pdf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
