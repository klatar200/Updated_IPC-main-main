# IPC Admin — Apache hardening
#
# This .htaccess locks down the /admin/ folder on Network Solutions shared
# hosting. It assumes mod_rewrite, mod_headers, and mod_deflate are enabled
# (they all are on standard Network Solutions cPanel hosting).

# Suppress version disclosure
ServerSignature Off
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# Force HTTPS — the login form posts a password and the session cookie is
# marked Secure (see admin/config.php), so plain HTTP must redirect first.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# No directory listings
Options -Indexes

# Force UTF-8 for PHP-rendered pages
AddDefaultCharset UTF-8

# Defense-in-depth response headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  # env=HTTPS is set by mod_ssl only when TLS terminates on THIS server. The
  # redirect above exists precisely because it often does not — %{HTTPS} reads
  # "off" on every request behind a TLS-terminating proxy, which is why that
  # rule needs its X-Forwarded-Proto condition. The two assumed opposite
  # topologies, so in the proxy case the one header meant to pin browsers to
  # HTTPS was silently never sent — on the half of the site that posts a
  # password and holds the session cookie.
  #
  # public/.htaccess was fixed this way in audit 5 and described itself as
  # "mirroring admin/.htaccess", which is how the asymmetry stayed invisible.
  # (audit-runs/audit6.md A-6.5)
  # PUB-1 — see public/.htaccess for why env=HTTPS, two lines, and no
  # includeSubDomains. The two files must stay in step.
  SetEnvIf X-Forwarded-Proto "^https$" IPC_TLS=1
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=IPC_TLS
  # Conservative CSP — the admin uses inline <style> blocks but no external JS.
  # form-action: SEC-16 (audit 2026-09-27) — it does NOT fall back to
  # default-src, so without it an injected <form> could post anywhere.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://placehold.co; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Block direct access to sensitive files in this directory.
#
# ALLOW-PASSWORD-RESET and README.md are here because neither matched the
# extension patterns: Apache served the reset flag as an empty 200, which gives
# a scanner a one-byte probe for "is the password-reset window open right now".
# (AUDIT_v3_FINDINGS NB14)
<FilesMatch "(^|/)(config\.php|config\.local\.php|\.htaccess|ALLOW-PASSWORD-RESET|README\.md|admin-log\.jsonl|\.login-throttle\.json|.*\.json|.*\.jsonl|.*\.bak|.*\.bak\..*|.*\.backup\..*)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Catch any timestamped JSON backups that ever land in /admin/
<FilesMatch "^products-all\.backup\.">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Restrict HTTP methods to the ones we actually use. HEAD is included so
# uptime monitors don't get a 403.
# NOT A TRACE GUARD — do not read it as one. TRACE is answered by Apache core
# before any .htaccess rule runs: LimitExcept, Rewrite [F] and <If> all miss
# it, and `TraceEnable Off` (the only switch) is not allowed in .htaccess.
# Measured (audit 2026-09-27 NEW-N3-6): TRACE → 200, echoing the request
# headers, IPCADMIN cookie included. Browsers cannot send TRACE, so the risk
# is small; the host must turn it off — GO-LIVE §C has the one-line check.
<LimitExcept GET POST HEAD>
  Order Allow,Deny
  Deny from all
</LimitExcept>
