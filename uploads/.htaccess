# /uploads/ — customer-uploaded product images (written by admin/upload-image.php).
# Deployed ONCE to public_html/uploads/, then written only by the admin —
# never re-upload this folder on subsequent deploys (same rule as /pdfs/ and /data/).

# No directory listings
Options -Indexes

# Never execute scripts from this folder, even if one somehow lands here.
#
# `(\.|$)`, not `$`: on a host that maps PHP with `AddHandler` (common on
# shared hosting), mod_mime hands a file to PHP for a .php extension ANYWHERE
# in its name, so `x.php.jpg` executes. The `$`-anchored rule this replaced
# never matched it. Same rule as pdfs/.htaccess, which is the one that held.
#
# ON PURPOSE — there is no image allow-list <FilesMatch> after this any more.
# There was one (`Order Deny,Allow` / `Allow from all` on jpe?g|png|webp|gif),
# and Apache merges matching sections in order, so it RE-ALLOWED any name
# ending in an image extension even when this deny had matched it: measured on
# real Apache 2.4 + mod_php, `x.php.jpg` answered 200 and ran. It added nothing
# else — Apache serves images by default. Do not put it back; to add
# deny-by-default later, put the allow BEFORE this block, never after.
# `_harness/dep3-scriptblock.js` proves both halves on a real Apache.
# (audit-runs/audit-2026-09-27.md DEP-3)
<FilesMatch "\.(?i:php|phtml|phps|php[0-9]|pht|phar|pl|py|cgi|sh|asp|aspx|jsp)(\.|$)">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Cache uploaded images for a day — replacements keep the same filename, so
# a shorter TTL keeps replaced photos from lingering too long.
<IfModule mod_headers.c>
  <FilesMatch "\.(?i:jpe?g|png|webp|gif)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
