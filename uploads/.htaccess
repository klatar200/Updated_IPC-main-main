# /uploads/ — customer-uploaded product images (written by admin/upload-image.php).
# Deployed ONCE to public_html/uploads/, then written only by the admin —
# never re-upload this folder on subsequent deploys (same rule as /pdfs/ and /data/).

# No directory listings
Options -Indexes

# Never execute scripts from this folder, even if one somehow lands here.
<FilesMatch "\.(?i:php|phtml|php[0-9]|pht|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Image types are explicitly allowed. NOTE — this is an allow-list on top of the
# script blacklist above, NOT a deny-by-default: a file whose extension is in
# neither list (.svg, .html, .txt) is still served by Apache's default. The
# comment here used to claim "everything else in here is blocked", which was
# true of the intent and false of the rules.
#
# Left as an allow-list deliberately. A real deny-by-default means adding a
# `<Files "*">Deny from all</Files>` above this, and whether images survive it
# depends on how Apache merges the two sections — which cannot be tested here,
# because `php -S` ignores .htaccess entirely (GUARDRAILS 4.3). Getting that
# wrong 404s every product photo on the live site, which is a far worse outcome
# than the gap it closes: nothing can land in this folder today except the five
# image types upload-image.php whitelists and cross-checks with getimagesize()
# and finfo, with SVG deliberately excluded. Fix the comment, keep the rules,
# and revisit with a real Apache to test against.
# (audit-runs/audit5.md, Low tier)
<FilesMatch "\.(?i:jpe?g|png|webp|gif)$">
  Order Deny,Allow
  Allow from all
</FilesMatch>

# Cache uploaded images for a day — replacements keep the same filename, so
# a shorter TTL keeps replaced photos from lingering too long.
<IfModule mod_headers.c>
  <FilesMatch "\.(?i:jpe?g|png|webp|gif)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
