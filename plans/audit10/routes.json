{
  "$schema_note": "The complete page inventory. 'slug' is the screenshot filename stem produced by _harness/audit10-crawl.js (URL with [/?&=%]+ replaced by _). Product IDs are NOT listed here — enumerate them from _harness/pristine/products-all.json at runtime (42 entries; the catalog is server-owned and this file must not fossilize it).",
  "server": {
    "base": "http://127.0.0.1:8123",
    "stand_up": [
      "npm install",
      "npm run build && sh _harness/sync.sh",
      "php -S 127.0.0.1:8123 -t _harness/site -c _harness/php-mail.ini _harness/router.php &"
    ],
    "admin_password": "audit-pass-123 (written into the MIRROR ONLY by sync.sh/setpw.php)",
    "run_from_repo_root": true
  },
  "public_routes": [
    { "url": "/", "slug": "home" },
    { "url": "/products", "slug": "products", "notes": "C29 catalog landing — 42 cards" },
    { "url": "/services", "slug": "services" },
    { "url": "/industries", "slug": "industries" },
    { "url": "/about", "slug": "about" },
    { "url": "/contact", "slug": "contact" },
    { "url": "/dashboard", "slug": "dashboard", "notes": "public sortable product index" },
    { "url": "/datasheets", "slug": "datasheets" },
    { "url": "/faq", "slug": "faq" },
    { "url": "/privacy", "slug": "privacy" }
  ],
  "parameterized_views": [
    { "pattern": "/products?productId=<id>", "source": "_harness/pristine/products-all.json (all 42 ids, encodeURIComponent)", "notes": "the product detail pages" },
    { "url": "/dashboard?family=Tape", "slug": "dashboard_family_Tape" },
    { "url": "/dashboard?family=Heat%20Shrink%20Tubing", "slug": "dashboard_family_Heat_20Shrink_20Tubing" },
    { "url": "/dashboard?family=Adhesive", "slug": "dashboard_family_Adhesive" }
  ],
  "error_states": [
    { "url": "/products?productId=NOPE-XYZ-123", "notes": "PLAN-9 soft-404: landing + banner + noindex; part of the shipped design now" },
    { "url": "/no-such-page", "notes": "A5 unknown segment: noindex, no canonical" }
  ],
  "admin_pages_get": [
    { "url": "/admin/", "slug": "admin_login", "auth": false, "notes": "signed-out login screen" },
    { "url": "/admin/index.php", "slug": "admin_index.php", "auth": true, "notes": "dashboard + health banner" },
    { "url": "/admin/content.php", "slug": "admin_content.php", "auth": true, "notes": "446 posted vars; form_complete LAST (invariant 6) — LOOK, do not edit" },
    { "url": "/admin/settings.php", "slug": "admin_settings.php", "auth": true },
    { "url": "/admin/add.php", "slug": "admin_add.php", "auth": true },
    { "url": "/admin/edit.php?id=CC", "slug": "admin_edit.php_id_CC", "auth": true },
    { "url": "/admin/backups.php", "slug": "admin_backups.php", "auth": true },
    { "url": "/admin/password.php", "slug": "admin_password.php", "auth": true },
    { "url": "/admin/inquiries.php", "slug": "admin_inquiries.php", "auth": true },
    { "url": "/admin/audit-log.php", "slug": "admin_audit-log.php", "auth": true },
    { "url": "/admin/help.php", "slug": "admin_help.php", "auth": true }
  ],
  "admin_post_only_do_not_screenshot": ["/admin/delete.php", "/admin/upload-image.php", "/admin/upload-pdf.php", "/admin/ping.php (health probe)", "/admin/auth.php (include)", "/admin/nav.php (include)", "/admin/config.php (include)"],
  "non_page_endpoints_check_headers_only": [
    { "url": "/sitemap.xml", "expect": "200 XML via sitemap.php rewrite emulation in router.php" },
    { "url": "/robots.txt", "expect": "200 text/plain" },
    { "url": "/data/content.json", "notes": "served by mirror; .htaccess caching UNVERIFIED locally" }
  ]
}
